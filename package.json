{
  "name": "@laioutr/app-b2bsellers",
  "version": "0.1.0",
  "description": "B2B Sellers connector app for Laioutr",
  "repository": "github:laioutr/app-b2bsellers",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "prepack": "nuxt-module-build build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run prepack && changeset publish",
    "test": "vitest run --passWithNoTests",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:watch": "vitest watch"
  },
  "browserslist": [
    "> 0.5% and not dead"
  ],
  "dependencies": {
    "@laioutr-core/kit": "^0.30.3",
    "@nuxt/kit": "3.16.2",
    "@shopware/api-client": "^1.5.0",
    "defu": "^6.1.4",
    "zod": "3.25.61"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@laioutr-core/orchestr-devtools": "^1.7.0",
    "@laioutr/eslint-config": "^1.8.8",
    "@laioutr/prettier-config": "^1.1.0",
    "@nuxt/devtools": "^2.6.3",
    "@nuxt/devtools-ui-kit": "2.5.0",
    "@nuxt/module-builder": "1.0.1",
    "@nuxt/schema": "3.16.2",
    "@nuxt/test-utils": "3.19.1",
    "@pinia/colada": "0.17.1",
    "@pinia/colada-nuxt": "0.2.1",
    "@types/node": "latest",
    "@vueuse/core": "13.1.0",
    "eslint": "^9.35.0",
    "nuxt": "3.16.2",
    "pinia": "3.0.2",
    "prettier": "^3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.1.1",
    "vue-tsc": "2.2.10"
  },
  "peerDependencies": {
    "@laioutr-core/canonical-types": ">=0.22.25",
    "@laioutr-core/core-types": ">=0.30.3",
    "@laioutr-core/frontend-core": ">=0.30.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.16.0"
  },
  "packageManager": "pnpm@10.34.1"
}
